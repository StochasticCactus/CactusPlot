#include <winver.h>
#include "Version.h"

IDI_ICON1 ICON "@CMAKE_SOURCE_DIR@/packaging/windows/cactusplot.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION CACTUS_VERSION_MAJOR, CACTUS_VERSION_MINOR, CACTUS_VERSION_PATCH, 0
PRODUCTVERSION CACTUS_VERSION_MAJOR, CACTUS_VERSION_MINOR, CACTUS_VERSION_PATCH, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "CactusPlot contributors\0"
            VALUE "FileDescription", "CactusPlot - scientific plotting\0"
            VALUE "FileVersion", CACTUS_VERSION "\0"
            VALUE "InternalName", "cactusplot\0"
            VALUE "LegalCopyright", "GNU General Public License v2 or later\0"
            VALUE "OriginalFilename", "cactusplot.exe\0"
            VALUE "ProductName", "CactusPlot\0"
            VALUE "ProductVersion", CACTUS_VERSION "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
